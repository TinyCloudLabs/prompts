{
  "name": "@tinycloud/auth-handoff",
  "version": "0.2.0-lean-auth.1",
  "private": true,
  "type": "module",
  "description": "Generic TinyCloud sign-in using the pinned TinyChat native paste flow",
  "engines": { "node": ">=22.20.0" },
